---
import "../styles/global.css";
const { title, images } = Astro.props;
---

<div class="quote-layout">
    <a href="/portfolio/insights">
        <div class="quote__arrow">
            <svg viewBox="0 0 24 24" class="arrow-icon">
                <path d="M15 6 L9 12 L15 18"></path>
            </svg>
        </div>
    </a>

    <h2 class="quote__title">{title}</h2>

    <div class="quote__content">
        <slot />
    </div>

    <div class="quote__buttons">
        {
            title === "Ux/ui" && (
                <>
                    <a href="/portfolio/quote/development" class="quote-btn">
                        Go to Development
                    </a>
                    <a href="/portfolio/quote/design" class="quote-btn">
                        Go to Design
                    </a>
                </>
            )
        }
        {
            title === "Development" && (
                <>
                    <a href="/portfolio/quote/design" class="quote-btn">
                        Go to Design
                    </a>
                    <a href="/portfolio/quote/ux-ui" class="quote-btn">
                        Go to UX/UI
                    </a>
                </>
            )
        }

        {
            title === "Design" && (
                <>
                    <a href="/portfolio/quote/ux-ui" class="quote-btn">
                        Go to UX/UI
                    </a>
                    <a href="/portfolio/quote/development" class="quote-btn">
                        Go to Development
                    </a>
                </>
            )
        }
    </div>

    <div class="quote__image-wrapper">
        {
            images &&
                images.map((img, index) => (
                    <img
                        src={img.src}
                        alt={title}
                        class={`quote__image quote__image--${index}`}
                        key={index}
                    />
                ))
        }
    </div>
</div>

<style>
    h2.quote__title {
        font-size: var(--size-xl);
        margin-top: 5rem;
    }

    .quote__image-wrapper {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        margin-left: -2rem;
    }

    .quote__image {
        width: 100%;
        height: 60%;
    }

    .quote__image--0 {
        grid-column: 1;
    }
    .quote__image--1 {
        grid-column: 2;
    }
    .quote__image--2 {
        grid-column: 3 / 5;
    }
    .quote__image--3 {
        grid-column: 5;
    }

    .quote-layout {
        width: 100%;
        padding: 2rem 1rem;
    }

    .quote__title {
        margin-top: -2rem;
        margin-bottom: 2rem;
    }

    .quote__content {
        max-width: 80%;
        line-height: 1.6;
        margin-bottom: 4rem;
        margin-left: 4rem;
        font-size: var(--size-ss);
    }

    .quote__buttons {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        margin-top: 2rem;
        margin-bottom: 3rem;
    }

    .quote__buttons .quote-btn {
        font-size: var(--size-mmml);
        padding: 3rem 5rem;
    }

    .arrow-icon {
        fill: none;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .quote__arrow {
        padding: 1rem;
        color: var(--color-red);
        width: 50px;
        height: 50px;
        border-radius: 50%;
        border: 3px solid var(--color-red);
        transition:
            opacity 0.3s ease,
            transform 0.3s ease;
        pointer-events: none;
        margin-bottom: 6rem;
        margin-right: 6rem;
        margin-left: 4rem;
    }

    @media screen and (min-width: 48em) {
        .quote__arrow {
            width: 60px;
            height: 60px;
        }
        .quote__image {
            width: 100%;
            height: 70%;
        }
        h2.quote__title {
            font-size: var(--size-ml);
        }

        .quote__buttons .quote-btn {
            font-size: 20px;
            padding: 2rem 5rem;
        }

        .quote__buttons {
            margin-top: -4rem;
        }
    }

    @media screen and (min-width: 80em) {
        .quote__arrow {
            margin-left: 2rem;
            width: 70px;
            height: 70px;
        }
        h2.quote__title {
            font-size: var(--size-l);
        }
        .quote__image {
            width: 100%;
            height: 60%;
        }
        h2.quote__title {
            font-size: var(--size-ml);
        }

        .quote__buttons .quote-btn {
            font-size: 20px;
            padding: 2rem 5rem;
        }

        .quote__buttons {
            margin-top: -4rem;
        }
    }
</style>
