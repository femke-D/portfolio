---
import "../styles/global.css";
import video from "../assets/gardigan.mp4";
import promo from "../assets/promo.mp4";
import casemovie from "../assets/casemovie.mp4";

const { title, description, tools, services, screen } = Astro.props;
---

<div class="markdown-layout">
    <a href="/portfolio/project" class="back-button"> Back to projects </a>

    <div class="project-header">
        <div class="project__image-wrapper">
            {
                screen ? (
                    <img src={screen.src} alt={title} class="project__image" />
                ) : (
                    <p>Geen afbeelding beschikbaar</p>
                )
            }
        </div>

        <h1 class="project__title">{title}</h1>
    </div>

    <div class="project-body-wrapper">
        <div class="project-info">
            <div class="info-row">
                <p class="project__description">
                    <strong class="word__category">Category:</strong>
                    <br />
                    {description}
                </p>

                <p class="project__description">
                    <strong class="word__tools">Tools:</strong>
                    <br />
                    {tools}
                </p>
            </div>

            <p class="project__description">
                <strong class="word__services">Services:</strong>
                <br />
                {services}
            </p>
        </div>

        <div class="project__content">
            <slot />

            {
                title === "Gardigan coffee" && (
                    <video
                        class="video_gardigan"
                        width="60%"
                        height="auto"
                        controls
                        muted
                        playsinline
                        preload="metadata"
                        class="project-video"
                    >
                        <source src={video} type="video/mp4" />
                    </video>
                )
            }
            {
                title === "The portal" && (
                    <div class="portal-videos">
                        <video
                            class="video_portal"
                            controls
                            muted
                            playsinline
                            preload="metadata"
                        >
                            <source src={promo} type="video/mp4" />
                        </video>

                        <video
                            class="video_portal"
                            controls
                            muted
                            playsinline
                            preload="metadata"
                        >
                            <source src={casemovie} type="video/mp4" />
                        </video>
                    </div>
                )
            }
        </div>
    </div>
</div>

<style>
    .markdown-layout {
        margin-top: 15rem;
    }

    .back-button {
        font-size: 50px;
        color: var(--color-red);
        margin-left: 5rem;
    }

    .back-button::before {
        content: "←";
        display: inline-block;
        margin-right: 0.6rem;
        transition: all 0.3s ease;
    }

    .project-header {
        width: 100%;
    }

    .project__image-wrapper {
        width: 100%;
        margin: 8rem 0;
    }

    .project__image {
        width: 100%;
        height: auto;
        display: block;
    }

    .project__title {
        font-size: var(--size-xxl);
    }

    .word__category,
    .word__tools,
    .word__services {
        font-size: var(--size-ml);
        font-weight: 400;
        color: var(--color-red);
    }

    .project__description {
        font-size: 35px;
        margin-bottom: 4rem;
        width: 750px;
    }

    .project-info {
        margin-left: 4rem;
    }

    .video_gardigan,
    .video_portal {
        width: 100%;
        height: auto;
        margin-top: 5rem;
    }

    .project__content {
        margin-top: 10rem;
    }

    .project__content :global(.intro) {
        font-size: 38px;
        margin-left: 4rem;
        width: 750px;
    }

    .project__content :global(.vraag-research) {
        font-size: 38px;
        font-weight: bold;
        margin-left: 4rem;
        width: 800px;
        margin-bottom: 7rem;
    }

    .project__content :global(.see-buttons) {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        margin-right: 5rem;
        margin-top: 5rem;
        margin-bottom: 5rem;
        gap: 1.5rem;
    }
    .project__content :global(.see-button) {
        display: block;
        font-size: 45px;
        color: var(--color-dblauw);
    }

    .project__content :global(.second-titel) {
        font-size: 80px;
        color: var(--color-dblauw);
        font-family: var(--font-header);
        margin-left: 4rem;
        margin-top: 10rem;
    }

    .project__content :global(.second-text) {
        font-size: 38px;
        margin-left: 4rem;
        width: 850px;
    }

    :global(.project__content img) {
        width: 100%;
        height: auto;
        display: block;
        justify-self: center;
        margin-top: 3rem;
    }
    :global(.frame) {
        display: block;
        justify-self: center;
    }

    .project__content :global(.project-switch) {
        display: flex;
        gap: 4rem;
        justify-content: center;
        margin-bottom: 8rem;
    }
    .project__content :global(.switch-btn) {
        background: none;
        border: 2px solid var(--color-dblauw);
        padding: 0.5rem 1.5rem;
        cursor: pointer;
        font-family: inherit;
        font-size: var(--size-ml);
        color: var(--color-dblauw);
        text-transform: uppercase;
        transition: all 0.3s ease;
    }

    .project__content :global(.switch-btn.active) {
        background-color: var(--color-dblauw);
        color: white;
        border-color: var(--color-dblauw);
    }

    .project__content :global(.project-tab) {
        display: none;
        flex-direction: column;
        margin-left: 4rem;
        margin-bottom: 4rem;
    }

    .project__content :global(.project-tab.active) {
        display: block;
    }

    @media screen and (min-width: 32em) {
        .back-button {
            font-size: 40px;
        }

        .project__title {
            font-size: var(--size-xl);
        }

        .word__category,
        .word__tools,
        .word__services {
            font-size: 40px;
        }

        .project__description {
            font-size: 30px;
        }

        .project__content {
            margin-top: 10rem;
        }

        .project__content :global(.intro) {
            font-size: 30px;
            width: 800px;
        }

        .project__content :global(.vraag-research) {
            font-size: 32px;
        }

        .project__content :global(.see-buttons) {
            margin-bottom: 10rem;
            gap: 1rem;
        }
        .project__content :global(.see-button) {
            font-size: 40px;
        }


        .project__content :global(.second-text) {
            font-size: 30px;
        }

        :global(.project__content img) {
            width: 70%;
        }
        
        .project__content :global(.switch-btn) {
            font-size: 40px;
        }
    }

