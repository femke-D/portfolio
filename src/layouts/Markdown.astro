---
import "../styles/global.css";
const { title, description, image } = Astro.props;
---

<div class="markdown-layout">
    <a href="/portfolio/project">
        <div class="project__arrow">
            <svg viewBox="0 0 24 24" class="arrow-icon">
                <path d="M15 6 L9 12 L15 18"></path>
            </svg>
        </div>
    </a>
    <div class="project-header">
        <h2 class="project__title">{title}</h2>
        <p class="project__description">{description}</p>
        <div class="project__image-wrapper">
            <img src={image} alt={title} class="project__image" />
        </div>
    </div>

    <div class="project__content">
        <slot />
    </div>
</div>

<style>
    h2.project__title {
        font-size: var(--size-xl);
        margin-top: 5rem;
    }

    .markdown-layout {
        width: 100%;
        padding: 2rem 1rem;
    }

    .project-header {
        margin-bottom: 3rem;
    }

    .project__description {
        font-size: 25px;
        margin-bottom: 2rem;
    }

    .project__image {
        width: 100%;
        height: auto;
        object-fit: cover;
        object-position: center;
        margin-top: -10rem;
    }

    .project__content {
        max-width: 90%;
        line-height: 1.6;
        margin-top: -2rem;
    }

    :global(.project__content h2) {
        margin-top: 3rem;
        margin-bottom: -0.5rem;
    }

    .project__image-wrapper {
        width: 100%;
        height: 300px;
        overflow: hidden;
        margin-bottom: 4rem;
        margin-top: 4rem;
        position: relative;
    }

    .arrow-icon {
        fill: none;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .project__arrow {
        padding: 1rem;
        color: var(--color-red);
        width: 50px;
        height: 50px;
        border-radius: 50%;
        border: 3px solid var(--color-red);
        transition:
            opacity 0.3s ease,
            transform 0.3s ease;
        pointer-events: none;
        margin-bottom: 6rem;
        margin-right: 6rem;
        margin-left: 4rem;
    }

    @media screen and (min-width: 48em) {
        :global(.project__content p),
        .project__description,
        .project__image {
            margin-left: 4rem;
        }

        .project__arrow {
            width: 60px;
            height: 60px;
        }
        .project__image-wrapper {
            height: 400px;
            margin-top: -2rem;
            display: flex;
            justify-content: flex-end;
            align-items: flex-start;
            margin-bottom: 6rem;
        }
        .project__image {
            width: 60%;
            margin-top: -18rem;
        }
        .project__description {
            margin-top: -1rem;
        }

        h2.project__title {
            font-size: var(--size-ml);
        }
    }

    @media screen and (min-width: 80em) {
        .project__arrow {
            margin-left: 2rem;
            width: 70px;
            height: 70px;
        }
        .project__image-wrapper {
            height: 300px;
            width: 80%;
            margin-left: auto;
            margin-right: 0;
        }
        .project__image {
            margin-left: 12rem;
            width: 80%;
            margin-top: -23rem;
        }

        h2.project__title {
            font-size: var(--size-l);
        }
    }
</style>
