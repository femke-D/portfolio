---
import "../styles/global.css";
const { title, description, tools, services, screen } = Astro.props;
---

<div class="markdown-layout">
    <a href="/portfolio/project" class="back-button"> Back to projects </a>

    <div class="project-header">
        <div class="project__image-wrapper">
            {
                screen ? (
                    <img src={screen.src} alt={title} class="project__image" />
                ) : (
                    <p>Geen afbeelding beschikbaar</p>
                )
            }
        </div>

        <h1 class="project__title">{title}</h1>
    </div>

    <div class="project-body-wrapper">
        <div class="project-info">
            <p class="project__description">
                <strong class="word_category">Category:</strong>
                <br />
                {description}
            </p>
            <p>
                <strong class="word__tools">Tools:</strong>
                <br />
                {tools}
            </p>
            <p>
                <strong class="word__services">Services:</strong>
                <br />
                {services}
            </p>
        </div>

        <div class="project__content">
            <slot />
        </div>
    </div>
</div>

<style>
    .back-button {
        align-items: center;
        color: var(--color-red);
        text-decoration: none;
        margin-left: 4rem;
    }

    .back-button::before {
        content: "←";
        display: inline-block;
        margin-right: 0.6rem;
        transition: all 0.3s ease;
    }

    .back-button:hover::before {
        transform: translateX(-5px);
    }

    .back-button:hover {
        color: var(--color-dblauw);
    }

    h1.project__title {
        margin-top: 8rem;
        margin-left: 4rem;
        font-size: var(--size-xl);
    }

    .markdown-layout {
        overflow-x: hidden;
        width: 100%;
        margin-top: 5rem;
    }

    .project-header {
        margin-top: 10rem;
    }

    .project__image-wrapper {
        width: 100vw;
        margin: 4rem 0;
        display: flex;
        justify-content: center;
        position: relative;
        left: 50%;
        transform: translateX(-50%);
    }

    .project__image {
        width: 100%;
        height: auto;
        object-fit: contain;
    }

    .project-info {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        margin-left: 4rem;
        margin-top: 4rem;
    }

    .project-info p {
        font-size: 40px;
    }

    .word_category,
    .word__tools,
    .word__services {
        color: var(--color-red);
        font-size: 50px;
        font-weight: 200;
        display: block;
    }

    .header-text {
        max-width: 600px;
        margin: 0 auto;
    }

    :global(.project__content p) {
        margin-top: 5rem;
        font-size: 40px;
        line-height: 1.6;
        max-width: auto;
        margin-left: 4rem;
        margin-right: 4rem;
    }

    .project__content {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
    }

    :global(.project__figma) {
        padding: 1.5rem 3rem;
        font-size: 45px;
        transition: transform 0.3s ease;
        color: var(--color-dblauw);
    }

    :global(.project__figma:hover) {
        transform: scale(1.05);
    }

    :global(.project__content img) {
        max-width: 100%;
        height: auto;
        display: block;
        padding-top: 5rem;
    }

    :global(.frame) {
        grid-column: 1 / -1;
        justify-self: center;

        width: 100%;
        max-width: 1000px;
        height: 600px;
        margin-top: 8rem;
        display: block;
        border-radius: 20px;
    }
    :global(.link) {
        margin-right: 8rem;
        font-size: 45px;
    }

    @media screen and (min-width: 48em) {
        .back-button {
            font-size: 37px;
            margin-left: 4rem;
        }

        h1.project__title {
            margin-top: 8rem;
            margin-left: 4rem;
            font-size: var(--size-xl);
        }

        .project-info {
            gap: 3rem;
            margin-left: 4rem;
            margin-top: 4rem;
        }

        .project-info p {
            font-size: 40px;
            margin-top: 1.5rem;
        }

        .word_category,
        .word__tools,
        .word__services {
            font-size: 50px;
        }

        :global(.project__content p) {
            margin-top: 5rem;
            font-size: 40px;
            margin-left: 4rem;
            margin-right: 4rem;
            max-width: 1000px;
        }

        :global(.project__figma) {
            font-size: 45px;
            padding: 1.5rem 3rem;
            margin-right: 4rem;
        }
    }

    @media screen and (min-width: 80em) {
        .markdown-layout {
            max-width: 1400px;
            margin: 0 auto;
            margin-top: 6rem;
        }

        .project-body-wrapper {
            display: grid;
            grid-template-columns: 400px 1fr;
            column-gap: 2rem;
            align-items: start;
            padding: 0 4rem;
        }

        .project__content {
            display: contents;
        }

        :global(.project__content p) {
            grid-column: 2;
            font-size: var(--size-ssm);
            max-width: 600px;
            line-height: 1.8;
            margin-left: 4rem;
            margin-top: 2rem;
        }

        :global(.project__content p:has(img)) {
            grid-column: 1 / -1;
            display: flex;
            flex-wrap: wrap;
            gap: 2rem;
            align-items: flex-start;
            max-width: 100%;
            margin-top: 2rem;
            margin-left: 0;
        }

        :global(.project__content img) {
            width: calc(50% - 1rem);
            height: auto;
            object-fit: contain;
            display: block;
            margin: 0;
            margin-top: -4rem;
        }

        .project-info {
            grid-column: 1;
            display: flex;
            flex-direction: column;
            gap: 1rem;
            margin-top: 2rem;
        }

        .project-info p {
            font-size: 20px;
        }
        .word_category,
        .word__tools,
        .word__services {
            font-size: var(--size-mml);
        }

        .project__image-wrapper {
            width: 100vw;
            height: 400px;
            margin-left: calc(-50vw + 50%);
            margin-top: 2rem;
            margin-bottom: 6rem;
            overflow: hidden;
        }

        .project__image {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        :global(.project__figma) {
            grid-column: 2;
            justify-self: end;
            display: flex;
            font-size: 30px;
            text-align: right;
            margin-top: -10rem;
            margin-right: -2rem;
        }

        :global(.link) {
            margin-right: 0;
            grid-column: 2;
            justify-self: end;
            display: flex;
            font-size: 30px;
            text-align: right;
            margin-top: -7rem;
            margin-right: 1rem;
        }

        :global(.frame) {
            margin-bottom: 5rem;
        }
    }
</style>
