---
import "../styles/global.css";
import video from "../assets/gardigan.mp4";
import promo from "../assets/promo.mp4";
import casemovie from "../assets/casemovie.mp4";

const { title, description, tools, services, screen } = Astro.props;
---

<div class="markdown-layout">
    <a href="/portfolio/project" class="back-button"> Back to projects </a>

    <div class="project-header">
        <div class="project__image-wrapper">
            {
                screen ? (
                    <img src={screen.src} alt={title} class="project__image" />
                ) : (
                    <p>Geen afbeelding beschikbaar</p>
                )
            }
        </div>

        <h1 class="project__title">{title}</h1>
    </div>

    <div class="project-body-wrapper">
        <div class="project-info">
            <p class="project__description">
                <strong class="word__category">Category:</strong>
                <br />
                {description}
            </p>
            <p class="project__description">
                <strong class="word__tools">Tools:</strong>
                <br />
                {tools}
            </p>
            <p class="project__description">
                <strong class="word__services">Services:</strong>
                <br />
                {services}
            </p>
        </div>

        <div class="project__content">
            <slot />

            {
                title === "Gardigan coffee" && (
                    <video
                        class="video_gardigan"
                        width="60%"
                        height="auto"
                        controls
                        muted
                        playsinline
                        preload="metadata"
                        class="project-video"
                    >
                        <source src={video} type="video/mp4" />
                    </video>
                )
            }
            {
                title === "The portal" && (
                    <video
                        class="video_portal"
                        width="60%"
                        height="auto"
                        controls
                        muted
                        playsinline
                        preload="metadata"
                        class="project-video"
                    >
                        <source src={promo} type="video/mp4" />
                    </video>
                )
            }
            {
                title === "The portal" && (
                    <video
                        class="video_portal"
                        width="60%"
                        height="auto"
                        controls
                        muted
                        playsinline
                        preload="metadata"
                        class="project-video"
                    >
                        <source src={casemovie} type="video/mp4" />
                    </video>
                )
            }
        </div>
    </div>
</div>

<style>
    :global(.see-button) {
        display: inline-flex;
        align-items: center;
        text-decoration: none;
        transition: all 0.3s ease;
    }

    :global(.see-button::after) {
        content: "→";
        display: inline-block;
        opacity: 0;
        margin-left: 0.5rem;
        transform: translateX(-10px);
        transition: all 0.3s ease;
        pointer-events: none;
    }

    :global(.see-button:hover::after) {
        opacity: 1;
        transform: translateX(0);
    }

    :global(.see-button:hover) {
        color: var(--color-red);
    }

    :global(.see-button) {
        color: var(--color-dblauw);
        font-size: var(--size-ssm);
    }

    :global(.project-switch) {
        display: flex;
        gap: 1rem;
        margin-left: 4rem;
        margin-bottom: 2rem;
    }

    :global(.switch-btn) {
        background: none;
        border: 2px solid var(--color-dblauw);
        padding: 0.5rem 1.5rem;
        cursor: pointer;
        font-family: inherit;
        font-size: var(--size-sm);
        color: var(--color-dblauw);
        text-transform: uppercase;
        transition: all 0.3s ease;
    }

    :global(.switch-btn.active) {
        background-color: var(--color-dblauw);
        color: white;
        border-color: var(--color-dblauw);
    }

    .back-button {
        align-items: center;
        color: var(--color-red);
        text-decoration: none;
        margin-left: 2rem;
    }

    .back-button::before {
        content: "←";
        display: inline-block;
        margin-right: 0.6rem;
        transition: all 0.3s ease;
    }

    h1.project__title {
        margin-left: 4rem;
        font-size: var(--size-l);
    }

    .markdown-layout {
        overflow-x: hidden;
        width: 100%;
        margin-top: 5rem;
    }

    .project-header {
        margin-top: 10rem;
    }

    .project__image-wrapper {
        width: 100vw;
        margin: 8rem 0;
        display: flex;
        justify-content: center;
        position: relative;
        left: 50%;
        transform: translateX(-50%);
    }

    .project__image {
        width: 100%;
        height: auto;
        object-fit: contain;
    }

    .project-info {
        display: flex;
        flex-direction: column;
        margin-left: 4rem;
        margin-bottom: 4rem;
    }

    .word__category,
    .word__tools,
    .word__services {
        color: var(--color-red);
        font-size: 30px;
        font-weight: 200;
        display: block;
        margin-bottom: -0.5rem;
    }

    .project__description {
        font-size: 20px;
        font-weight: 300;
    }

    :global(.project__content p),
    :global(.second-text),
    :global(.vraag-research) {
        font-size: 20px;
        font-weight: 400;
        line-height: 1.8;
        max-width: auto;
    }

    :global(.vraag-research) {
        font-weight: bold;
    }

    :global(.second-text) {
        margin-top: 6rem;
    }
    :global(.second-titel) {
        font-size: 45px;
        font-weight: bold;
    }

    .project__content {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
    }

    :global(.project__figma) {
        padding: 1.5rem 3rem;
        font-size: 45px;
        transition: transform 0.3s ease;
        color: var(--color-dblauw);
    }

    :global(.project__figma:hover) {
        transform: scale(1.05);
    }

    :global(.project__content img) {
        max-width: 100%;
        height: auto;
        display: block;
        padding-top: 5rem;
    }

    :global(.frame) {
        grid-column: 1 / -1;
        justify-self: center;

        width: 100%;
        max-width: 1000px;
        height: 600px;
        margin-top: 8rem;
        display: block;
        border-radius: 20px;
    }

    :global(.link) {
        margin-right: 8rem;
        font-size: 45px;
    }

    .video_gardigan {
        align-self: center;
        width: 100%;
    }

