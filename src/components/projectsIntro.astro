---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

const alleProjecten = await getCollection("projecten");
const gewensteIndexen = [1, 3, 7];

const projecten = alleProjecten.filter((_, index) =>
    gewensteIndexen.includes(index),
);

projecten.sort((a, b) => {
    return (
        gewensteIndexen.indexOf(alleProjecten.indexOf(a)) -
        gewensteIndexen.indexOf(alleProjecten.indexOf(b))
    );
});
---

<section class="work">
    <h2 class="work__title">My Work</h2>

    <ul class="work__list">
        {
            projecten.map((project) => (
                <li class="work__item">
                    <a
                        href={`/portfolio/work/${project.id}/`}
                        class="work__link"
                    >
                        <div class="work__wrapper">
                            <Image
                                class="work__image"
                                src={project.data.image}
                                alt={project.data.title}
                            />
                        </div>

                        <div class="work__content">
                            <h3 class="work__subtitle">{project.data.title}</h3>
                            <p class="work__description">
                                {project.data.description}
                            </p>
                        </div>

                        <div class="work__arrow">
                            <svg viewBox="0 0 24 24" class="arrow-icon">
                                <path
                                    d="M9 6 L15 12 L9 18"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                />
                            </svg>
                        </div>
                    </a>
                </li>
            ))
        }
    </ul>

    <div class="work__more">
        <a href="/portfolio/project" class="btn-more"> All of my work </a>
    </div>
</section>

<style>
    .work {
        /* Padding verwijderd voor maximale breedte van de foto's */
        width: 100%;
        margin-bottom: 5rem;
    }

    .work__title {
        margin-top: 4rem;
        margin-bottom: 1.5rem;
        padding: 0 1.5rem; /* Titel wel wat binnenruimte geven */
        font-size: 2rem;
        color: var(--color-dblauw);
    }

    .work__list {
        display: flex;
        flex-direction: column;
        gap: 4rem; /* Ruimte tussen de projecten */
        padding: 0;
        margin: 0;
        list-style: none;
    }

    .work__item {
        width: 100%;
    }

    .work__link {
        text-decoration: none;
        display: block;
        color: inherit;
    }

    /* Foto's GROTER: nemen de volledige breedte in */
    .work__wrapper {
        width: 100%;
        aspect-ratio: 16 / 9; /* Houdt de verhouding strak, pas aan indien nodig */
        overflow: hidden;
    }

    .work__image {
        width: 100%;
        height: 100%;
        object-fit: cover; /* Zorgt dat de foto de container vult zonder vervorming */
        display: block;
    }

    .work__content {
        margin-top: 1.2rem;
        padding: 0 1.5rem; /* Tekst weer wat binnenruimte geven */
    }

    .work__subtitle {
        font-size: 1.4rem;
        font-weight: 700;
        margin: 0;
        color: var(--color-red);
        display: flex;
        align-items: center;
    }

    .work__arrow-inline {
        display: inline-block;
        margin-left: 0.5rem;
        transform: translateX(-5px);
        opacity: 0;
        transition: all 0.3s ease;
    }


    .work__description {
        font-size: 1rem;
        margin: 0.5rem 0 0 0;
        color: var(--color-dblauw);
        opacity: 0.8;
        line-height: 1.5;
        max-width: 90%;
    }

    .work__more {
        display: flex;
        justify-content: center;
        margin-top: 4rem;
    }

    .btn-more::after {
        content: "→";
        display: inline-block;
        margin-left: 0.3rem;
        transition: all 0.3s ease;
    }

   
    @media screen and (min-width: 48em) {
        .work::before {
            top: 5rem;
            height: 95%;
        }

        .work__list {
            margin-left: 4rem;
            display: flex;
            flex-direction: row;
            overflow-x: auto;
            gap: 10rem;
            scroll-snap-type: x mandatory;
            padding-bottom: 1.5rem;
        }

        .work__item {
            flex-shrink: 0;
            scroll-snap-align: start;
            max-width: 300px;
        }

        .work__arrow {
            right: 1rem;
            bottom: 1rem;
            width: 50px;
            height: 50px;
        }

        .work__list::-webkit-scrollbar {
            height: 8px;
        }

        .work__list::-webkit-scrollbar-track {
            background: transparent;
        }

        .work__list::-webkit-scrollbar-thumb {
            background: var(--color-red);
            border-radius: 4px;
        }
    }

    @media screen and (min-width: 80em) {
        .work::before {
            top: 5rem;
            height: 95%;
        }
        .work__item {
            opacity: 1;
            transition: opacity 0.3s ease;
            max-width: 350px;
        }
        .work__arrow {
            opacity: 0;
            transform: translateX(1rem);
            transition:
                opacity 0.3s ease,
                transform 0.3s ease;
        }

        .work__item:hover .work__arrow {
            opacity: 1;
            transform: translateX(0);
        }

        .work__item:hover .work__arrow {
            opacity: 1;
            transform: translateX(0);
        }

        .work__item:hover .work__image {
            transform: scale(1.05);
        }
        .work__item:hover .work__subtitle,
        .work__item:hover .work__description,
        .work__item:hover .work__subtitle::after {
            opacity: 1;
        }

        .work__item:hover .work__wrapper::before {
            background: rgba(223, 201, 178, 0.5);
        }

        .work__subtitle {
            font-size: var(--size-mmml);
            margin-left: 0;
        }

        .work__description {
            font-size: var(--size-ss);
            margin-top: 1rem;
            margin-left: 0;
        }
    }
</style>
