---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

const alleProjecten = await getCollection("projecten");
const gewensteIndexen = [0, 5, 7];

const projecten = alleProjecten.filter((_, index) =>
    gewensteIndexen.includes(index),
);

projecten.sort((a, b) => {
    return (
        gewensteIndexen.indexOf(alleProjecten.indexOf(a)) -
        gewensteIndexen.indexOf(alleProjecten.indexOf(b))
    );
});
---

<section class="work">
    <h2 class="work__title">My Work</h2>

    <ul class="work__list">
        {
            projecten.map((project) => (
                <li class="work__item">
                    <a
                        href={`/portfolio/work/${project.id}/`}
                        class="work__link"
                    >
                        <div class="work__wrapper">
                            <Image
                                class="work__image"
                                src={project.data.image}
                                alt={project.data.title}
                            />
                        </div>

                        <div class="work__content">
                            <h3 class="work__subtitle">{project.data.title}</h3>
                            <p class="work__description">
                                {project.data.description}
                            </p>
                        </div>
                    </a>
                </li>
            ))
        }
    </ul>

    <div class="work__more">
        <a href="/portfolio/project" class="btn-more"> All of my work </a>
    </div>
</section>

<style>
    .work {
        width: 100%;
        margin-bottom: 5rem;
    }

    .work__title {
        margin-top: 4rem;
        margin-bottom: 1.5rem;
        color: var(--color-dblauw);
    }

    .work__list {
        display: flex;
        flex-direction: column;
        gap: 4rem;
        padding: 0;
        margin: 0;
        list-style: none;
    }

    .work__item {
        width: 100%;
    }

    .work__link {
        text-decoration: none;
        display: block;
        color: inherit;
    }

    .work__wrapper {
        width: 100%;
        aspect-ratio: 16 / 9;
        overflow: hidden;
    }

    .work__image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .work__content {
        margin-top: 1.2rem;
    }

    .work__subtitle {
        font-size: var(--size-ss);
        font-weight: 600;
        margin: 0;
        text-transform: uppercase;
        color: var(--color-red);
    }

    .work__description {
        font-size: var(--size-ssm);
        margin: 0.5rem 0 0 0;
        color: var(--color-dblauw);
    }

    .work__more {
        display: flex;
        justify-content: end;
        margin-top: 4rem;
    }

    @media screen and (min-width: 48em) {
        .work {
            margin-top: 10rem;
        }

        .work__list {
            margin-left: 4rem;
            display: flex;
            flex-direction: row;
            flex-wrap: nowrap;
            gap: 1rem;
            padding-bottom: 1.5rem;
        }

        .work__item {
            flex: 1;
            max-width: auto;
            min-width: 0;
        }

        .work__content {
            padding-left: 0;
            padding-right: 1rem;
        }

        .work__subtitle {
            font-size: var(--size-ss);
        }

        .work__description {
            font-size: var(--size-ssm);
            max-width: 100%;
        }

        .btn-more {
            margin-right: 8rem;
        }
    }

    @media screen and (min-width: 80em) {
        .work {
            margin-top: 0;
        }

        .work__item {
            opacity: 1;
            transition: opacity 0.3s ease;
            margin-top: 2rem;
        }

        .work__item:hover .work__image {
            transform: scale(1.05);
        }

        .work__subtitle {
            font-size: var(--size-ss);
        }

        .work__description {
            font-size: var(--size-ssm);
        }
    }
</style>
