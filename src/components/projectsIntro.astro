---
import { Image } from "astro:assets";

import { getCollection } from "astro:content";
const projecten = await getCollection("projecten");
---

<section class="work">
    <h2 class="work__title">My Work</h2>

    <ul class="work__list">
        {
            projecten.map((project) => (
                <li class="work__item">
                    <a
                        href={`/portfolio/work/${project.id}/`}
                        class="work__link"
                    >
                        <div class="work__wrapper">
                            <Image
                                class="work__image"
                                src={project.data.image}
                                alt={project.data.title}
                            />
                            <h3 class="work__subtitle">{project.data.title}</h3>
                            <p class="work__description">
                                {project.data.description}
                            </p>
                        </div>
                        <div class="work__arrow">
                            <svg viewBox="0 0 24 24" class="arrow-icon">
                                <path
                                    d="M9 6 L15 12 L9 18"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                />
                            </svg>
                        </div>
                    </a>
                </li>
            ))
        }
    </ul>
</section>

<style>
    .work__title {
        margin-top: 5rem;
    }
    .work {
        position: relative;
        z-index: 1;
    }
    .work::before {
        content: "";
        position: absolute;
        top: 5.3rem;
        left: 0;
        width: 100%;
        height: 90%;
        background-image: url("../assets/back.png");
        background-repeat: no-repeat;
        background-size: cover;
        z-index: -1;
    }

    .work__text {
        margin-top: 0;
        position: absolute;

        display: flex;
        flex-direction: column;
        justify-content: space-between;

        font-size: var(--size-mml);
        color: var(--color-dblauw);
        opacity: 0.3;
        text-transform: uppercase;
        font-weight: 100;
        gap: 0.5rem;
    }

    .work__text .row {
        white-space: nowrap;
    }
    .work__list {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
    }

    .work__item {
        position: relative;
        overflow: hidden;
    }

    .work__link {
        display: block;
        text-decoration: none;
        color: inherit;
    }

    .work__wrapper {
        position: relative;
        width: 100%; 
        max-width: 350px;
        overflow: hidden;
        margin: 0;
        margin-top: 3rem;
    }

    .work__image {
        width: 100%;
        height: auto;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .work__subtitle,
    .work__description {
        position: absolute;
        left: 2rem;
        opacity: 0;
        transition: opacity 0.3s ease;
        color: var(--color-red);
    }

    .work__subtitle {
        top: 2rem;
        font-size: var(--size-ss);
        font-weight: 600;
        margin: 0;
    }

    .work__description {
        top: 4.5rem;
        font-size: 20px;
        margin: 0;
        max-width: 70%;
    }

    .work__arrow {
        position: absolute;
        right: 0.4rem;
        bottom: 1rem;
        color: var(--color-red);

        width: 40px;
        height: 40px;
        border-radius: 50%;
        border: 2px solid var(--color-red);

        display: flex;
        align-items: center;
        justify-content: center;

        opacity: 1;
        transform: translateX(0);
        z-index: 3;
        pointer-events: none;
    }

    .work__arrow .arrow-icon {
        width: 22px;
        height: 22px;
        stroke: var(--color-red);
    }

    .work__wrapper::before {
        content: "";
        position: absolute;
        inset: 0;
        transition: background 0.3s ease;
        z-index: 1;
    }

    .work__subtitle,
    .work__description,
    .work__subtitle::after {
        z-index: 2;
    }

    @media screen and (min-width: 48em) {
        .work::before {
            top: 5rem;
            height: 95%;
        }

        .work__list {
            margin-left: 4rem;
            display: flex;
            flex-direction: row;
            overflow-x: auto;
            gap: 10rem;
            scroll-snap-type: x mandatory;
            padding-bottom: 1.5rem;
        }

        .work__item {
            flex-shrink: 0;
            scroll-snap-align: start;
            max-width: 300px;
        }

        .work__arrow {
            right: 1rem;
            bottom: 1rem;
            width: 50px;
            height: 50px;
        }

        .work__list::-webkit-scrollbar {
            height: 8px;
        }

        .work__list::-webkit-scrollbar-track {
            background: transparent;
        }

        .work__list::-webkit-scrollbar-thumb {
            background: var(--color-red);
            border-radius: 4px;
        }
    }

    @media screen and (min-width: 80em) {
        .work::before {
            top: 5rem;
            height: 95%;
        }
        .work__item {
            opacity: 1;
            transition: opacity 0.3s ease;
            max-width: 350px;
        }
        .work__arrow {
            opacity: 0;
            transform: translateX(1rem);
            transition:
                opacity 0.3s ease,
                transform 0.3s ease;
        }

        .work__item:hover .work__arrow {
            opacity: 1;
            transform: translateX(0);
        }

        .work__item:hover .work__arrow {
            opacity: 1;
            transform: translateX(0);
        }

        .work__item:hover .work__image {
            transform: scale(1.05);
        }
        .work__item:hover .work__subtitle,
        .work__item:hover .work__description,
        .work__item:hover .work__subtitle::after {
            opacity: 1;
        }

        .work__item:hover .work__wrapper::before {
            background: rgba(223, 201, 178, 0.5);
        }

        .work__subtitle {
            font-size: var(--size-mmml);
            margin-left: 0;
        }

        .work__description {
            font-size: var(--size-ss);
            margin-top: 1rem;
            margin-left: 0;
        }
    }
</style>
