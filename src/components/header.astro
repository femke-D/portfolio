---
import header from "../assets/header.svg";
import header1 from "../assets/header-1.png";
import header2 from "../assets/header-2.png";
import header3 from "../assets/header-3.png";
import header4 from "../assets/header-4.png";
import header5 from "../assets/header-5.png";
import header6 from "../assets/header-6.png";
import header7 from "../assets/header-7.png";
import header8 from "../assets/header-8.png";
import header9 from "../assets/header-9.png";
import header10 from "../assets/header-10.png";
---

<header>
    <div class="header-grid">
        <p class="header-start">I am Femke Denoo</p>
        <div class="header__img-container">
            <img class="header-img" src={header.src} alt="Header image" />
            <img class="header-img" src={header1.src} alt="Header image" />
            <img class="header-img" src={header2.src} alt="Header image" />
            <img class="header-img" src={header3.src} alt="Header image" />
            <img class="header-img" src={header4.src} alt="Header image" />
            <img class="header-img" src={header5.src} alt="Header image" />
            <img class="header-img" src={header6.src} alt="Header image" />
            <img class="header-img" src={header7.src} alt="Header image" />
            <img class="header-img" src={header8.src} alt="Header image" />
            <img class="header-img" src={header9.src} alt="Header image" />
            <img class="header-img" src={header10.src} alt="Header image" />
        </div>
        <div class="header-block block-ux">
            <p class="header-sub">Ux / ui</p>
            <h1 class="header-title ux">UX / UI</h1>
        </div>
        <div class="header-block block-design">
            <p class="header-sub">Designer</p>
            <h1 class="header-title design">DESIGNER</h1>
        </div>
        <div class="header-block block-dev">
            <p class="header-sub">Developer</p>
            <h1 class="header-title development">DEVELOPER</h1>
        </div>

        <a href="mailto:femke.denoo@proximus.be" class="header-cta"
            >Send me a mail</a
        >
    </div>
</header>

<style>
    .header-grid {
        margin-bottom: 4rem;
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        grid-template-rows: auto 6rem 6rem 12rem 6rem 2rem;
    }

    .header-start {
        grid-column: 5 / 7;
        grid-row: 1;
        color: var(--color-mblauw);
        font-size: var(--size-s);
        align-self: end;
        justify-self: end;
        margin-bottom: 1.5rem;
    }

    .header-sub {
        font-family: var(--font-detail);
        font-size: var(--size-ml);
        color: var(--color-red);
        margin: 0;
    }

    .header__img-container {
        position: relative;
        grid-column: 2 / span 4;
        grid-row: 2 / 5;
        justify-self: center;
        align-self: center;
        width: 100%;
        max-width: 360px;
        height: auto;
        z-index: -1;
    }

    .header-img {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 100%;
        max-width: 360px;
        height: auto;
        opacity: 0;
    }

    .header-img.active {
        opacity: 1;
    }

    .block-ux {
        grid-column: 1 / 5;
        grid-row: 2;
        justify-self: start;
        align-self: start;
    }

    .block-design {
        grid-column: 4 / 7;
        grid-row: 3;
        justify-self: start;
        align-self: center;
        text-align: left;
    }

    .block-dev {
        grid-column: 2 / 5;
        grid-row: 5;
        justify-self: start;
        align-self: end;
        margin-left: -1.5rem;
    }

    .ux,
    .design,
    .development {
        font-size: var(--size-ml);
        margin-top: -2.2rem;
    }

    .header-title {
        font-family: var(--font-header);
        color: var(--color-dblauw);
    }

    .header-cta {
        grid-column: 4 / 7;
        grid-row: 6;
        align-self: end;
        justify-self: end;
    }

    @media screen and (min-width: 48em) {
        .header-grid {
            margin-top: 0;
            margin-top: 1rem;
            grid-template-columns: repeat(8, 1fr);
            grid-template-rows: 2rem 6rem 4rem 13rem 7rem 2rem;
            margin-bottom: 4rem;
        }

        .header-start {
            grid-column: 5 / 8;
            grid-row: 1;
            margin-right: -2rem;
            margin-bottom: 0;
            font-size: var(--size-m);
        }

        .header__img-container {
            grid-column: 2 / 8;
            grid-row: 3 / 5;
        }

        .block-ux {
            grid-column: 3 / 6;
            margin-left: -3rem;
            grid-row: 2;
        }

        .block-design {
            grid-column: 6 / 8;
            grid-row: 3;
            margin-bottom: -6rem;
        }

        .block-dev {
            grid-column: 3 / 5;
            grid-row: 6;
            margin-left: 3rem;
            margin-bottom: -2rem;
        }

        .header-cta {
            grid-column: 6 / 9;
            margin-right: 8rem;
            grid-row: 5;
            font-size: 16px;
        }

        .ux,
        .design,
        .development,
        .header-sub {
            font-size: var(--size-l);
        }

        .header-sub {
            margin-bottom: -4rem;
            margin-left: -0.5rem;
        }
    }

    @media screen and (min-width: 80em) {
        .header-grid {
            grid-template-columns: repeat(8, 1fr);
            grid-template-rows: 3rem 4rem 4rem 8rem 14rem 3rem;
        }

        .header-start {
            grid-column: 7 / 9;
            grid-row: 1;
            margin-right: 3rem;
            font-size: var(--size-ss);
        }

        .header__img-container {
            grid-column: 2 / 8;
            grid-row: 2 / 6;
        }

        .block-ux {
            grid-column: 3 / 5;
            grid-row: 1;
        }

        .block-design {
            grid-column: 6 / 8;
            grid-row: 4;
            margin-top: -3rem;
        }

        .block-dev {
            grid-column: 4 / 6;
            grid-row: 5;
            margin-left: -8rem;
            margin-bottom: -8rem;
        }

        .header-cta {
            grid-column: 7 / 9;
            grid-row: 6;

            margin-right: 5rem;
            font-size: 16px;
        }

        .header-sub {
            margin-bottom: -4rem;
            margin-left: -0.5rem;
        }

        .ux,
        .design,
        .development,
        .header-sub {
            font-size: var(--size-xxl);
        }
    }
</style>

<script>
    const $images = document.querySelectorAll(".header-img");
    let currentIndex = 0;
    const intervalTime = 3000;

    $images.length && ($images[0].style.opacity = "1");

    const nextImage = () => {
        gsap.to($images[currentIndex], {
            opacity: 0,
            duration: 0.8,
            ease: "power2.inOut",
        });

        currentIndex = (currentIndex + 1) % $images.length;

        gsap.to($images[currentIndex], {
            opacity: 1,
            duration: 0.8,
            ease: "power2.inOut",
        });
    };

    setInterval(nextImage, intervalTime);
</script>
