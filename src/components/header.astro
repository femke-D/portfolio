---
import header from "../assets/header.svg";
import header1 from "../assets/header-1.png";
import header2 from "../assets/header-2.png";
import header3 from "../assets/header-3.png";
import header4 from "../assets/header-4.png";
import header5 from "../assets/header-5.png";
import header6 from "../assets/header-6.png";
import header7 from "../assets/header-7.png";
import header8 from "../assets/header-8.png";
import header9 from "../assets/header-9.png";
import header10 from "../assets/header-10.png";
---

<header>
    <div class="header-grid">
        <a href="mailto:femke.denoo@proximus.be" class="header-cta"
            >Send me an email</a
        >
        <div class="header__img-container">
            <img class="header-img" src={header.src} alt="Header image" />
            <img class="header-img" src={header1.src} alt="Header image" />
            <img class="header-img" src={header2.src} alt="Header image" />
            <img class="header-img" src={header3.src} alt="Header image" />
            <img class="header-img" src={header4.src} alt="Header image" />
            <img class="header-img" src={header5.src} alt="Header image" />
            <img class="header-img" src={header6.src} alt="Header image" />
            <img class="header-img" src={header7.src} alt="Header image" />
            <img class="header-img" src={header8.src} alt="Header image" />
            <img class="header-img" src={header9.src} alt="Header image" />
            <img class="header-img" src={header10.src} alt="Header image" />
        </div>
        <p class="header-start">I am Femke Denoo</p>
    </div>

    <div class="block-skill">
        <h1 class="header-title ux">UX / UI</h1>
        <h1 class="header-title design">DESIGNER</h1>
        <h1 class="header-title development">DEVELOPER</h1>
    </div>
</header>

<style>
    .header-grid {
        display: grid;
        grid-template-columns: 1fr;
        grid-template-rows: auto auto;
        align-items: center;
        justify-items: center;
        margin-top: 2rem;
    }

    .header-cta {
        grid-row: 1;
        grid-column: 1;
        justify-self: end;
    }

    .header__img-container,
    .header-start {
        grid-row: 2;
        grid-column: 1;
    }

    .header-start {
        font-family: var(--font-detail);
        -webkit-text-stroke: 2px #7c170d;
        color: var(--color-red);
        font-size: var(--size-l);
        z-index: 2;
        text-align: center;
        align-self: start;
        margin-top: 1.5rem;
    }

    .header__img-container {
        width: 100%;
        height: 500px;
        display: grid;
        place-items: center;
        z-index: 1;
    }

    .header-img {
        grid-row: 1;
        grid-column: 1;
        width: 75%;
        max-width: 450px;
        height: 100%;
        object-fit: contain;
        opacity: 0;
    }

    .header-img.active {
        opacity: 1;
    }

    .block-skill {
        display: grid;
        grid-template-columns: repeat(2, auto);
        grid-template-rows: auto auto auto;
        gap: 10px;
        margin-top: -4rem;
        width: 100%;
    }

    .header-title {
        margin: 0;
        padding: 5px 15px;
        width: 100%;
        box-sizing: border-box;

        font-family: var(--font-header);
        font-size: 50px;
        line-height: 1;
        color: var(--color-dblauw);
        background-color: var(--color-lbeige);
    }

    .ux {
        grid-column: 1 /-1;
        grid-row: 1;
    }
    .design {
        grid-column: 1 /-1;
        grid-row: 2;
    }
    .development {
        grid-column: 1 /-1;
        grid-row: 3;
    }

    @media screen and (min-width: 26em) {
        .header__img-container,
        .header-start {
            margin-top: 3rem;
        }
        .header-start {
            margin-top: 1rem;
        }
        .block-skill {
            margin-top: -2rem;
        }
    }

    @media screen and (min-width: 34em) {
        .header-start {
            font-size: var(--size-xxl);
        }
        .block-skill {
            margin-top: 2rem;
        }
    }
    @media screen and (min-width: 39em) {
        .header-start {
            font-size: var(--size-xxl);
        }
        .block-skill {
            margin-top: 8rem;
        }

        .header-title {
            font-size: var(--size-l);
        }
        .header-cta {
            margin-right: 2rem;
            margin-bottom: 2rem;
        }
    }

    @media screen and (min-width: 48em) {
        .header-img {
            width: 45%;
        }
        .block-skill {
            margin-top: -2rem;
        }
    }

    @media screen and (min-width: 56em) {
        .block-skill {
            margin-top: 2rem;
        }
        .header-start {
            font-size: var(--size-xxl);
            grid-column: 1 / -1;
            margin-left: 10rem;
        }

        .header-grid {
            grid-template-columns: 1fr 1fr;
        }

        .header-img {
            width: 80%;
        }

        .header-cta {
            grid-column: 2;
        }

        .header__img-container {
            grid-column: 1;
        }
    }

    @media screen and (min-width: 63em) {
        .block-skill {
            margin-top: 2rem;
        }
        .header-start {
            font-size: var(--size-xxxl);
            grid-column: 1 / -1;
            margin-left: 10rem;
        }

        .header-img {
            margin-top: -5rem;
            width: 90%;
        }
    }
    @media screen and (min-width: 90em) {
        .block-skill {
            margin-top: 2rem;
        }
        .header-start {
            margin-top: 4rem;
            font-size: var(--size-xxxl);
        }

        .header-img {
            width: 100%;
        }
        .header__img-container {
            margin-top: 0;
            width: 100%;
            height: 600px;
        }
        .block-skill {
            margin-top: -2rem;
            gap: 1.5rem;
        }
        .header-title {
            font-size: var(--size-xl);
        }
        .header-cta {
            margin-right: 7rem;
        }
    }
</style>

<script>
    const $images = document.querySelectorAll(".header-img");
    let currentIndex = 0;
    const intervalTime = 3000;

    $images.length && ($images[0].style.opacity = "1");

    const nextImage = () => {
        gsap.to($images[currentIndex], {
            opacity: 0,
            duration: 0.8,
            ease: "power2.inOut",
        });

        currentIndex = (currentIndex + 1) % $images.length;

        gsap.to($images[currentIndex], {
            opacity: 1,
            duration: 0.8,
            ease: "power2.inOut",
        });
    };

    setInterval(nextImage, intervalTime);
</script>
