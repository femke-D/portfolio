---
import me from "../assets/me.png";
---

<section class="about about__intro">
    <h2 class="about__title">About me</h2>
    <p class="about__greeting">Hey</p>
    <img
        class="about__img"
        src={me.src}
        width="400"
        height="400"
        loading="lazy"
        alt="Zelfportret"
    />
    <p class="about__text">
        Ik ben Femke Denoo, afgestudeerd in Digital Design & Development
        (devine), met een passie voor UX/UI en interactieve,
        gebruiksvriendelijke digitale ervaringen.
        <br />
        <br />
        Wat mij drijft? Nieuwsgierigheid. Ik wil blijven leren, andere culturen ontdekken
        en mezelf uitdagen om steeds beter te worden. Die motivatie om te groeien
        vormt de basis van mijn werk als designer.
        <br />
        <br />
        Ik werk graag binnen het UX/UI- en digital design-luik, waar ik mijn skills
        kan inzetten om projecten zo gebruiksvriendelijk en intuïtief mogelijk te
        maken. Ik combineer graag visueel design met functionele UX, om zo ontwerpen
        te creëren die er niet alleen goed uitzien, maar ook echt werken voor de
        gebruiker.
        <br />
        <br />
        Naast mijn liefde voor design, hou ik ervan om de wereld te ontdekken en
        in contact te komen met andere culturen. Ik probeer bewust te leven, te genieten
        van kleine momenten en gewoon mens te zijn of dat nu met een koffietje is,
        een avondje met vrienden of wat me-time.
    </p>
</section>

<style>
    .about__img {
        display: none;
        width: 100%; 
        max-width: 400px; 
        height: auto; 
        justify-self: start;
    }

    .about__greeting {
        margin-left: 0.5rem;
        margin-bottom: 0.5rem;
        margin-top: 2rem;
    }

    .about__text {
        margin-top: 0;
        margin-left: 1rem;
        max-width: 90%;
    }

    @media screen and (min-width: 48em) {
        .about__intro {
            margin-left: 4rem;
            margin-right: 4rem;
            display: grid;
            grid-template-columns: 60px 1fr auto;
            grid-template-rows: auto auto auto;
            margin-top: 3rem;
        }

        .about__title {
            grid-row: 1;
            grid-column: 2;
            margin: 0;
        }

        .about__greeting {
            font-size: var(--size-xxl);
            grid-row: 2;
            grid-column: 2;
            margin-left: -2rem;
        }

        .about__text {
            grid-column: 1 / 3;
            grid-row: 3;
            margin-left: 2rem;
        }

        .about__img {
            display: block;
            grid-column: 3;
            grid-row: 3;
            margin-left: 1rem;
        }
    }

    @media screen and (min-width: 80em) {
        .about__intro {
            display: grid;
            grid-template-columns: 180px 30rem 1fr;
            grid-template-rows: auto auto auto;
            margin-top: 3rem;
            column-gap: 2rem;
        }

        .about__title {
            grid-row: 1;
            grid-column: 2;
            margin: 0;
        }

        .about__greeting {
            font-size: var(--size-xxl);
            grid-row: 2;
            grid-column: 2;
            margin-bottom: 0;
            margin-left: -4rem;
        }

        .about__text {
            grid-column: 2;
            grid-row: 3;
            margin: 0;
        }

        .about__img {
            display: block;
            grid-column: 3;
            grid-row: 3;
            margin-left: 2rem;
        }
    }
</style>

<script>
    const greetings = ["Hoi", "Hey", "Salut", "Hallo", "Hola", "Ciao", "Oi"];
    const $changingGreeting = document.querySelector(".about__greeting");

    const getRandomGreeting = () => {
        return greetings[Math.floor(Math.random() * greetings.length)];
    };

    const init = () => {
        setInterval(() => {
            $changingGreeting.textContent = getRandomGreeting();
        }, 2000);
    };

    init();
</script>
