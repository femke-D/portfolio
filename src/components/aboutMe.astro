---
import me from "../assets/me.png";
---

<section class="about">
    <h2 class="about__title">About me</h2>

    <div class="about__intro">
        <p class="about__text">
            I’m Femke Denoo, a Digital Design & Development (Devine) student
            with a strong interest in UX/UI and digital design. I genuinely
            enjoy creating digital experiences that feel right, both visually
            and in the way people interact with them.
            <br />
            <br />
            What excites me about design is the constant search for better solutions.
            I like questioning things, rethinking flows and refining details until
            everything feels clear and intuitive. It’s that mix of creativity and
            problem-solving that keeps me motivated.
            <br />
            <br />
            I’m someone who learns by doing. I like experimenting, pushing ideas further
            and continuously improving my work. For me, growth comes from staying
            curious and not being afraid to try new things.
            <br />
            <br />
            Outside of design, I find a lot of inspiration in discovering the world
            around me. I love exploring new places, getting to know different cultures
            and meeting new people. At the same time, I really value slowing down
            and enjoying simple moments, whether that’s a coffee, an evening with
            friends or just some time to myself.
            <br />
            <br />
            <span class="about-experience">EXCHANGE EXPERIENCE:</span>
            <br />
            Right now, I'm on an exchange program at University of Wisconsin Stout.
            I'm learning all kind of new skills. I have chosen to dig deeper into
            UX/UI, Branding, 3D animation & Advertising. I'm so glad to get this opportunity
            to discover a little bit more of the world.
        </p>

        <div class="about__container">
            <p class="about__greeting">Hey</p>

            <img
                class="about__img"
                src={me.src}
                width="400"
                height="400"
                loading="lazy"
                alt="Zelfportret"
            />
        </div>
    </div>
</section>

<style>
    .about-experience {
        font-weight: 800;
    }
    
     .about__intro {
        display: grid;
        grid-template-columns: auto 40px;
    }

    .about__content {
        grid-column: 1;
    }

    .about__text {
        z-index: 2;
        grid-column: 1 /-1;
        grid-row: 1;
        margin-top: 3rem;
    }

    .about__container {
        grid-column: 1 /-1;
        grid-row: 1;
        justify-self: end;
    }

    .about__img {
        display: none;
    }

    .about__greeting {
        margin-top: -4rem;
        z-index: 4;
    }

    @media screen and (min-width: 31em) {
        .about__intro {
            grid-template-columns: auto auto;
        }
        .about__container {
            grid-column: 2;
            justify-self: start;
            align-self: start;

            display: grid;
        }
        .about__img {
            display: block;
            width: 200px;
            height: auto;
            grid-column: 1;
            grid-row: 1;
        }

        .about__text {
            grid-column: 1;
            margin-top: 0;
        }

        .about__greeting {
            grid-column: 1;
            grid-row: 1;
            z-index: 2;
            margin-top: -5rem;
        }
    }

    @media screen and (min-width: 39em) {
        .about__intro {
            gap: 2rem;
        }
    }
    @media screen and (min-width: 48em) {
        .about__intro {
            gap: 0;
            margin-left: 4rem;
        }

        .about__text {
            width: 340px;
        }
        .about__img {
            width: 250px;
        }
    }

    @media screen and (min-width: 58em) {
        .about__text {
            width: 450px;
        }
        .about__img {
            width: 300px;
        }
    }
    @media screen and (min-width: 66em) {
        .about__text {
            width: 450px;
        }
        .about__img {
            width: 350px;
        }
        .about__greeting {
            margin-top: -4rem;
            font-size: var(--size-xxxl);
        }
    }

    @media screen and (min-width: 78em) {
        .about {
            margin-bottom: 10rem;
        }
        .about__text {
            width: 500px;
        }
        .about__intro,
        .about__title {
            margin-left: 8rem;
        }
        .about__greeting {
            margin-left: -2rem;
        }
    }
</style>

<script>
    const greetings = ["Hoi", "Hey", "Salut", "Hallo", "Hola", "Ciao", "Oi"];
    const $changingGreeting = document.querySelector(".about__greeting");

    const getRandomGreeting = () => {
        return greetings[Math.floor(Math.random() * greetings.length)];
    };

    const init = () => {
        setInterval(() => {
            $changingGreeting.textContent = getRandomGreeting();
        }, 2000);
    };

    init();
</script>
