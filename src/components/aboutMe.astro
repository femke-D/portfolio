---
import me from "../assets/me.png";
---

<section class="about about__intro">
    <h2 class="about__title">About me</h2>

    <div class="about__container">
        <img
            class="about__img"
            src={me.src}
            width="400"
            height="400"
            loading="lazy"
            alt="Zelfportret"
        />
        <p class="about__greeting">Hey</p>
    </div>

    <p class="about__text">
        I’m Femke Denoo, a Digital Design & Development (Devine) student with a
        strong interest in UX/UI and digital design. I genuinely enjoy creating
        digital experiences that feel right, both visually and in the way people
        interact with them.
        <br />
        <br />
        What excites me about design is the constant search for better solutions.
        I like questioning things, rethinking flows and refining details until everything
        feels clear and intuitive. It’s that mix of creativity and problem-solving
        that keeps me motivated.
        <br />
        <br />
        I’m someone who learns by doing. I like experimenting, pushing ideas further
        and continuously improving my work. For me, growth comes from staying curious
        and not being afraid to try new things.
        I'm on an exchange program at University of Wisconsin Stout. I'm learning all kind of new skills. I have chosen to dig deeper into UX/UI, Branding, 3D animation & Advertising. 
        I'm so glad to get this opportunity to discover a little bit more of the world. 
        <br />
        <br />
        Outside of design, I find a lot of inspiration in discovering the world around
        me. I love exploring new places, getting to know different cultures and meeting
        new people. At the same time, I really value slowing down and enjoying simple
        moments, whether that’s a coffee, an evening with friends or just some time
        to myself.
    </p>
</section>

<style>
    .about__container {
        display: grid;
        grid-template-columns: 120px 1fr;
    }
    .about__img {
        grid-column: 2;
        grid-row: 1;
        width: 100%;
        height: auto;
        display: none;
    }

    .about__greeting {
        grid-column: 1;
        grid-row: 1;
        align-self: flex-end;
        margin: 0;
        margin-bottom: -4rem;
        margin-left: 1rem;
        font-size: var(--size-xxl);
        z-index: 2;
    }

    .about__text {
        clear: right;
        margin-top: 4rem;
        margin-left: 1rem;
        max-width: 87%;
        line-height: 1.8;
    }

    @media screen and (min-width: 48em) {
        .about__intro {
            display: grid;
            grid-template-columns: 1fr 400px;
            column-gap: 1rem;
            align-items: start;
        }

        .about__title {
            grid-column: 1 / -1;
        }

        .about__container {
            display: contents;
        }

        .about__greeting {
            grid-column: 1;
            grid-row: 2;
            align-self: start;
            margin: 0 0 1rem 0;
            margin-left: 8rem;
        }

        .about__text {
            grid-column: 1;
            grid-row: 3;
            max-width: 480px;
            margin-left: 10rem;
            margin-top: 0;
        }

        .about__img {
            grid-column: 2;
            grid-row: 2 / 4;
            width: 90%;
            margin: 0;
            align-self: center;
            display: block;
        }
    }

    @media screen and (min-width: 80em) {
        .about__intro {
            grid-template-columns: 1fr 450px;
            column-gap: 5rem;
            max-width: 1300px; 
        }

        .about__greeting {
            margin-left: 8rem; 
            font-size: calc(var(--size-xxl) * 1.2); 
        }

        .about__text {
            margin-left: 10rem;
            max-width: 550px;
        }

        .about__img {
            width: 100%;
        }

        .about__title {
            margin-bottom: 4rem;
        }
    }
</style>

<script>
    const greetings = ["Hoi", "Hey", "Salut", "Hallo", "Hola", "Ciao", "Oi"];
    const $changingGreeting = document.querySelector(".about__greeting");

    const getRandomGreeting = () => {
        return greetings[Math.floor(Math.random() * greetings.length)];
    };

    const init = () => {
        setInterval(() => {
            $changingGreeting.textContent = getRandomGreeting();
        }, 2000);
    };

    init();
</script>
