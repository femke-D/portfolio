---
import { getCollection } from "astro:content";
const allQuotes = await getCollection("quotes");

const designQuotes = allQuotes
    .filter((entry) => entry.data.category === "design")
    .flatMap((entry) => entry.data.zinnetjes);

const uxuiQuotes = allQuotes
    .filter((entry) => entry.data.category === "ux/ui")
    .flatMap((entry) => entry.data.zinnetjes);

const devQuotes = allQuotes
    .filter((entry) => entry.data.category === "development")
    .flatMap((entry) => entry.data.zinnetjes);
---

<section >
    <h2 class="insights__titel">Insights</h2>
    <div class="insights insights__quotes">
    <div class="insights__category insights__category--design">
        <a href="/portfolio/quote/design/">
        <div class="insights__carousel" data-category="design">
                <h2 class="insights__category-title">Design</h2>

            {
                designQuotes.map((quote, index) => (
                    <blockquote
                        class="insights__quote"
                        data-index={index}
                        style={index === 0 ? "" : "display: none;"}
                    >
                        <p class="insights__quote-text">"{quote.text}"</p>

                        <cite class="insights__quote-author">
                            — {quote.author}
                        </cite>
                    </blockquote>
                ))
            }
        </div>
    </a>
    </div>
    <div class="insights__category insights__category--uxui">
         <a href="/portfolio/quote/ux-ui/">
        <div class="insights__carousel" data-category="uxui">
            <h2 class="insights__category-title">UX/UI</h2>

            {
                uxuiQuotes.map((quote, index) => (
                    <blockquote
                        class="insights__quote"
                        data-index={index}
                        style={index === 0 ? "" : "display: none;"}
                    >
                        <p class="insights__quote-text">"{quote.text}"</p>
                        <cite class="insights__quote-author">
                            — {quote.author}
                        </cite>
                    </blockquote>
                ))
            }
        </div>
        </a>
    </div>
    <div class="insights__category insights__category--development">
        <a href="/portfolio/quote/development/">
        <div class="insights__carousel" data-category="development">
            <h2 class="insights__category-title">Development</h2>

            {
                devQuotes.map((quote, index) => (
                    <blockquote
                        class="insights__quote"
                        data-index={index}
                        style={index === 0 ? "" : "display: none;"}
                    >
                        <p class="insights__quote-text">"{quote.text}"</p>
                        <cite class="insights__quote-author">
                            — {quote.author}
                        </cite>
                    </blockquote>
                ))
            }
        </div>
        </a>
    </div>
    </div>
</section>


<style>

    .insights__carousel {
        display: grid;
        grid-template-columns: auto;
        grid-template-rows: auto;
        max-width: 150px;
        margin-left: 1rem;
        background-color: var(--color-lbeige);
        padding: 1rem;
        margin-bottom: 2rem;
    }

    .insights__category-title {
        color: var(--color-red);
        font-size: var(--size-sm);
        grid-column: 1;
        grid-row: 2;
        justify-self: end;
        margin: 0;
    }

    .insights__quote-author {
        font-size: var(--size-xs);
    }

    .insights__category-title {
        color: var(--color-red);
        font-size: var(--size-sm);
    }

    .insights__quote-author {
        font-size: var(--size-xs);
    }

    .insights__quote {
        transition: opacity 0.5s ease-in-out;
        margin: 0;
        margin-bottom: 1rem;
    }

    .insights__quote-text {
        font-size: var(--size-s);
    }

    .insights__category--uxui {
        display: flex;
        align-items: end;
        justify-content: end;
        margin-top: -1rem;
    }

     .insights__category--development {
        margin-top: -1rem;
    }

     @media screen and (min-width: 48em) {
           .insights__quotes {
            display: grid;
            grid-template-columns: repeat(2, 1fr); 
            grid-template-rows: repeat(2, 1fr);
            align-items: start;
        }

        .insights__carousel {
            max-width: 250px; 
            padding: 2rem;
            margin-left: 10rem;
            min-height: 250px; 
            height: auto; 
            overflow: hidden; 
        }

        .insights__category--design {
            grid-column: 1; 
            grid-row: 1; 

        }
        .insights__category--development {
            grid-column: 1;
            grid-row: 2;
            margin-top: 2rem;
            margin-left: 5rem;
            
        }

        .insights__category--uxui {
            grid-column: 2; 
            grid-row: 1 / 3; 
            margin: 0;
            margin-right: 6rem;
            margin-top: 10rem;
        }

        .insights__category-title {
            font-size: var(--size-mml);
        }
        .insights__quote-author {
            font-size: var(--size-sm);
        }
        .insights__quote-text {
            font-size: var(--size-m);
        }
    }

    @media screen and (min-width: 80em) {
        .insights__carousel:hover {
        transform: scale(1.05);
    }
    .insights__quotes {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        grid-template-rows: repeat(2, 1fr); 
        align-items: start;
        }

        .insights__category-title {
            font-size: var(--size-mml);
        }

        .insights__quote-author {
            font-size: var(--size-m);
        }

        .insights__quote-text {
            font-size: var(--size-ss);
        }

        .insights__carousel {
            min-width: 300px;
            margin-left: 4rem;
            padding: 4rem;
            height: auto;
            overflow: hidden;
        }

        .insights__category--design {
            grid-column: 1; 
            grid-row: 1; 
        }
        .insights__category--development{
            grid-column: 1;
            grid grid-row: 2;
            margin-left: 10rem;
        }

        .insights__category--uxui{
            margin-top: 15rem;
            grid-column: 2 ;
            grid grid-row: 1 / 3 ; 
            margin-right: 10rem;
        }
    }
</style>

<script>
    const $carousels = document.querySelectorAll(".insights__carousel");

    const loopQuotes = (carousel) => {
        const quotes = carousel.querySelectorAll(".insights__quote");
        if (quotes.length <= 1) return;

        let currentIndex = 0;
        quotes.forEach((q, i) => q.style.display = i === 0 ? "block" : "none");

        setInterval(() => {
            quotes[currentIndex].style.display = "none";
            currentIndex = (currentIndex + 1) % quotes.length;
            quotes[currentIndex].style.display = "block";
        }, 5000);
    };

const initCarousels = () => {
  $carousels.forEach(carousel => loopQuotes(carousel));
};

    initCarousels();

    document.addEventListener("astro:page-load", initCarousels);
</script>
