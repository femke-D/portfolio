---
import skills from "../data/skills.json";
---

<section class="skills">
    <div class="skills__wrapper">
        <div class="skills__track">
            <ul class="skills__list list1">
                {
                    skills.map((skill) => (
                        <li class="skills__item">{skill.skills}</li>
                    ))
                }
            </ul>
            <ul class="skills__list list2" aria-hidden="true">
                {
                    skills.map((skill) => (
                        <li class="skills__item">{skill.skills}</li>
                    ))
                }
            </ul>
        </div>
    </div>
</section>

<style>
    .list2 {
        margin-left: 2rem;
    }
    .skills__wrapper {
        margin-top: 2rem;
        overflow: hidden;
        width: 100%;
    }
    .skills__track {
        display: flex;
        width: max-content;
    }
    .skills__list {
        display: flex;
        gap: 2rem;
        white-space: nowrap;
        animation: scroll 20s linear infinite;
    }
    .skills__item {
        flex-shrink: 0;
        font-size: 20px;
        font-weight: 100;
        color: var(--color-red);
    }

    @keyframes scroll {
        0% {
            transform: translateX(0);
        }
        100% {
            transform: translateX(-100%);
        }
    }

    @media screen and (min-width: 48em) {
        .skills__item {
            font-size: var(--size-ss);
        }
        .skills__list {
            gap: 3rem;
        }
        .list2 {
            margin-left: 3rem;
        }
    }

    @media screen and (min-width: 80em) {
        .skills__item {
            font-size: var(--size-mml);
        }
        .skills__list {
            gap: 5rem;
        }
        .list2 {
            margin-left: 5rem;
        }
    }
</style>

<script>
    const $track = document.querySelector(".skills__track");
    const $list = document.querySelector(".skills__list");

    const skills = () => {
        if ($track && $list) {
            const listWidth = $list.offsetWidth;
            const duration = listWidth / 50;
            $list.style.animationDuration = `${duration}s`;

            const secondList = $track.querySelectorAll(".skills__list")[1];
            if (secondList) {
                secondList.style.animationDuration = `${duration}s`;
            }
        }
    };
    skills();
</script>
