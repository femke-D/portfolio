        text-transform: uppercase;
        color: var(--color-dbeige);
        list-style: none;
        position: relative;
        margin: 0;
        padding: 0;
    }
    .falling-words-box {
        position: relative;
        width: 380px;
        min-width: 380px;
        max-width: 380px;
        height: 300px;
        overflow: visible;
    }

    .insight-quote li {
        position: absolute;
        white-space: nowrap;
    }

    .Q1 {
