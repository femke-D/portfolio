</style>

<script type="module">
    gsap.registerPlugin(ScrollTrigger);

    const $container = document.querySelector(".insight-quote");
    const $words = document.querySelectorAll(".insight-quote li");
    const boxHeight = 230;
    const wordStates = [];

    const storeOriginalRotations = () => {
        $words.forEach((word) => {
            const computed = window.getComputedStyle(word);
            word.dataset.originalRotate = computed.rotate || "0deg";
        });
    };

    const resetAnimation = () => {
        wordStates.forEach((state) => {
            state.settled = false;
            state.y = 0;
            state.velocity = 0;

            const originalRotate =
                state.element.dataset.originalRotate || "0deg";
            state.element.style.transform = `translateY(0px) rotate(${originalRotate})`;
        });
    };

    const animateWord = (state, index) => {
        const gravity = 0.5 + Math.random() * 0.3;
        let bounceFactor = 0.8 + Math.random() * 0.1;
        const bounceDecay = 0.96 + Math.random() * 0.02;
        const minBounceVelocity = 0.1 + Math.random() * 0.1;

        state.y = 0;
        state.velocity = 0;
        state.settled = false;
        state.element.style.rotate = "0deg";

        const animate = () => {
            if (state.settled) return;

            state.velocity += gravity;
            state.y += state.velocity;

            const bottomLimit = boxHeight - state.height;
            if (state.y > bottomLimit) {
                state.velocity *= -bounceFactor;
                bounceFactor *= bounceDecay;
            }

            for (let i = 0; i < index; i++) {
                const otherWord = wordStates[i];
                if (otherWord.settled) {
                    const otherTop = otherWord.y;
                    const thisBottom = state.y + state.height;
                    if (
                        thisBottom > otherTop &&
                        state.y < otherTop &&
                        state.velocity > 0
                    ) {
                        state.velocity *= -bounceFactor;
                        bounceFactor *= bounceDecay;
                        break;
                    }
                }
            }

            if (Math.abs(state.velocity) < minBounceVelocity) {
                state.velocity = 0;
                state.settled = true;
            }

            state.element.style.transform = `translateY(${state.y}px)`;
            requestAnimationFrame(animate);
        };

        animate();
    };

    const startAnimation = () => {
        $words.forEach((word, index) => {
            const state = wordStates[index] || {
                element: word,
                y: 0,
                velocity: 0,
                settled: false,
                height: word.offsetHeight,
            };
            wordStates[index] = state;

            animateWord(state, index);
        });
    };

    const initScrollTrigger = () => {
        ScrollTrigger.create({
            trigger: $container,
            start: "top+=100 center",
            end: "bottom top",
            onEnter: () => startAnimation(),
            onEnterBack: () => {
                resetAnimation();
                startAnimation();
            },
            markers: false,
        });
    };

    storeOriginalRotations();
    initScrollTrigger();
</script>
