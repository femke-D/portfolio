<section>
    <div class="insight-content">
        <h2 class="insight-titel">Insights</h2>
        <div class="falling-words-box">
            <ul class="insight-quote">
                <li class="Q1">Shine bright</li>
                <li class="Q2">Be fearless</li>
                <li class="Q3">Design life</li>
                <li class="Q4">Be unstoppable</li>
                <li class="Q5">Code dreams</li>
                <li class="Q6">Push limits</li>
                <li class="Q7">Dream big</li>
                <li class="Q8">Spark joy</li>
            </ul>
        </div>
    </div>

    <a href="/portfolio/insights" class="insight__button">
        Discover my insights
    </a>
</section>

<style>
    .insight-content {
        margin-top: 4rem;
