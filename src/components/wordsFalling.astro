            width: 400px;
            min-width: 400px;
            max-width: 800px;
            height: 500px;
        }

        .Q1 {
            top: 100;
            left: 240px;
            font-size: var(--size-ml);
        }
        .Q2 {
            top: 200;
            left: 400px;
            font-size: var(--size-l);
            rotate: -15deg;
        }
        .Q3 {
            top: 30px;
            left: 770px;
            font-size: var(--size-mmml);
            rotate: -25deg;
        }
        .Q4 {
