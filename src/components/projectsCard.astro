---
const { project } = Astro.props;
import { Image } from "astro:assets";
---

<section class="project">
    <a
        href={project.id ? `/portfolio/work/${project.id}/` : "#"}
        class="project__link"
    >
        <div class="project__wrapper">
            <Image
                class="project__image"
                src={project.data.image}
                alt={project.data.title}
            />
            <h3 class="project__subtitle">{project.data.title}</h3>
            <p class="project__description">{project.data.description}</p>
        </div>
    </a>
</section>

<style>
    .project {
        position: relative;
        margin-bottom: 2rem;
    }
    .project__link {
        display: block;
        text-decoration: none;
        color: inherit;
    }

    .project__wrapper {
        width: 100%;
        max-width: 380px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .project__image {
        width: 100%;
        height: auto;
        object-fit: cover;
        transition: transform 0.3s ease;
        margin-bottom: 1rem;
    }

    .project__subtitle,
    .project__description {
        color: var(--color-red);
    }

    .project__subtitle {
        font-size: var(--size-ss);
        font-weight: 600;
        margin: 0;
        text-transform: uppercase;
    }

    .project__description {
        margin: 0.2rem 0 0 0;
        font-size: var(--size-ssm);
        color: var(--color-dblauw);
    }

    @media screen and (min-width: 48em) {
        .project__wrapper {
            max-width: 320px;
            padding: 0;
        }

        .project__image {
            width: 100%;
            height: 100%;
            aspect-ratio: 3 / 2;
            object-fit: cover;
        }

        .project__description {
            font-size: var(--size-ssm);
        }
        .project__subtitle {
            font-size: var(--size-ss);
        }

        .project__image {
            aspect-ratio: 4 / 3;
            object-fit: contain;
            width: 100%;
            margin: 0 auto 0 auto;
        }
    }

    @media screen and (min-width: 80em) {
        .project__wrapper {
            max-width: 380px;
        }

        .project__image {
            width: 100%;
        }

        .project:hover .project__image {
            transform: scale(1.1);
        }
    }
</style>
