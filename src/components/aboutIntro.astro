---
import me from "../assets/me.png";
---

<section class="about">
    <div class="about-content">
        <h2 class="about-title">About me</h2>

        <p class="about-text">
            I am Femke Denoo, a Digital Design & Development (Devine) student at
            the Royal Academy of Fine Arts (KASK) and Howest University of
            Applied Sciences, with a strong interest in digital creation and an
            open mindset for new challenges and experiences.
            <br />
            <br />
            What drives me? Curiosity. I want to keep learning, discover other cultures,
            and challenge myself to constantly improve. That desire to grow forms
            the basis of my work as a designer.
        </p>

        <a href="/portfolio/about" class="about-button">Get to know me</a>
    </div>

    <div class="about-visual">
        <p class="about-intro">Hey</p>

        <div class="about-img-wrapper">
            <img
                class="about-img"
                src={me.src}
                loading="lazy"
                alt="Foto van mezelf"
            />
        </div>
    </div>
</section>

<style>
    .about {
        display: grid;
        grid-template-columns: 1fr auto;
        margin-top: 5rem;
        margin-bottom: 4rem;
    }

    .about-content {
        display: flex;
        flex-direction: column;
    }

    .about-title {
        margin: 0 0 30px;
    }

    .about-text {
        margin: 0 0 30px;
        width: auto;
    }

    .about-visual {
        position: relative;
    }

    .about-intro {
        position: absolute;
        top: -3rem;
        left: -7.5rem;
        margin: 0;
        z-index: 2;
    }

    .about-img {
        display: none;
    }
    @media screen and (min-width: 31em) {
        .about {
            grid-template-columns: 1fr auto;
            gap: 2rem;
        }
        .about-img {
            display: block;
            width: 200px;
        }
        .about-container {
            grid-column: 2;
        }
        .about-intro {
            left: -1rem;
        }
    }

    @media screen and (min-width: 39em) {
        .about-img {
            width: 250px;
        }
    }

    @media screen and (min-width: 47em) {
        .about {
            margin-left: 5rem;
        }
        .about-img {
            width: 300px;
        }
        .about-intro {
            font-size: var(--size-xxl);
        }
    }
    @media screen and (min-width: 57em) {
        .about {
            margin-left: 8rem;
            margin-right: 5rem;

            gap: 4rem;
        }
        .about-img {
            width: 300px;
        }
    }

    @media screen and (min-width: 69em) {
        .about {
            margin-right: 8rem;
            gap: 5rem;
        }
        .about-img {
            width: 350px;
        }
    }

    @media screen and (min-width: 69em) {
        .about {
            grid-template-columns: auto auto;
            justify-content: center;
            gap: 7rem;
        }
        .about-img {
            width: 350px;
        }
        .about-text {
            max-width: 400px;
        }
    }
    @media screen and (min-width: 89em) {
        .about {
            gap: 10rem;
        }
        .about-img {
            width: 350px;
        }
        .about-text {
            max-width: 540px;
        }

        .about-intro {
            font-size: var(--size-xxxl);
        }
    }
</style>

<script>
    const greetings = ["Hoi", "Hey", "Salut", "Hallo", "Hola", "Ciao", "Oi"];
    const $aboutIntro = document.querySelector(".about-intro");

    const getRandomGreeting = () => {
        return greetings[Math.floor(Math.random() * greetings.length)];
    };

    const init = () => {
        setInterval(() => {
            $aboutIntro.textContent = getRandomGreeting();
        }, 3000);
    };

    init();
</script>
