---
import me from "../assets/me.png";
---

<section class="about">
    <div class="about-content">
        <h2 class="about-title">About me</h2>

        <p class="about-text">
            I am Femke Denoo, a Digital Design & Development (Devine) student at
            the Royal Academy of Fine Arts (KASK) and Howest University of
            Applied Sciences, with a strong interest in digital creation and an
            open mindset for new challenges and experiences.
            <br />
            <br />
            What drives me? Curiosity. I want to keep learning, discover other cultures,
            and challenge myself to constantly improve. That desire to grow forms
            the basis of my work as a designer.
        </p>

        <a href="/portfolio/about" class="about-button">Get to know me</a>
    </div>

    <div class="about-visual">
        <p class="about-intro">Hey</p>

        <div class="about-img-wrapper">
            <img
                class="about-img"
                src={me.src}
                loading="lazy"
                alt="Foto van mezelf"
            />
        </div>
    </div>
</section>

<style>
    .about {
        display: grid;
        grid-template-columns: 1fr 1fr;
        margin-left: 10rem;
        margin-top: 10rem;
        margin-bottom: 10rem;
    }

    .about-content {
        display: flex;
        flex-direction: column;
    }

    .about-title {
        margin: 0 0 30px;
    }

    .about-text {
        margin: 0 0 30px;
        width: 463px;
    }

    .about-visual {
        position: relative;
    }

    .about-intro {
        position: absolute;
        top: -2rem;
        left: -3rem;
        margin: 0;
        z-index: 2;
    }

    .about-img-wrapper {
        width: 100%;
    }

    .about-img {
        width: auto;
        height: auto;
    }
    @media screen and (min-width: 48em) {
    }

    @media screen and (min-width: 80em) {
    }
</style>

<script>
    const greetings = ["Hoi", "Hey", "Salut", "Hallo", "Hola", "Ciao", "Oi"];
    const $aboutIntro = document.querySelector(".about-intro");

    const getRandomGreeting = () => {
        return greetings[Math.floor(Math.random() * greetings.length)];
    };

    const init = () => {
        setInterval(() => {
            $aboutIntro.textContent = getRandomGreeting();
        }, 3000);
    };

    init();
</script>
